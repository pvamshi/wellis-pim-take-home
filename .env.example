# Copy to .env and adjust. .env is gitignored; this example is not.

# --- Database --------------------------------------------------------------
# The scheme of DATABASE_URL alone selects the driver — not NODE_ENV, not a
# mode flag. Test, dev and production-shaped runs differ by which .env file is
# loaded, not by having three separate path variables.
#
# file:  -> local SQLite file on disk
# libsql: -> Turso, which also needs TURSO_AUTH_TOKEN below
DATABASE_URL=file:./data/dev.sqlite
# DATABASE_URL=libsql://<database>-<org>.turso.io

# Set only when DATABASE_URL uses the libsql:// scheme. Absent locally.
# TURSO_AUTH_TOKEN=

# --- Services --------------------------------------------------------------
# Port the backend listens on.
PORT=3000

# Backend base URL the frontend calls. The VITE_ prefix is mandatory — without
# it Vite will not expose the value to client code.
VITE_API_BASE_URL=http://localhost:3000
