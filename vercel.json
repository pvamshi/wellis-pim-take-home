{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:serverless -w apps/api && npm run build -w apps/web",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "node_modules/{libsql,@libsql,@neon-rs,detect-libc}/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
